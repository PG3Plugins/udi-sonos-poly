<nodeDefs>
    <!-- NODE DEF from 5.0 document http://wiki.universal-devices.com/index.php?title=V50_MAIN -->
    <!-- controller -->
    <nodeDef id="controller" nls="ctl">
        <editors />
        <sts>
            <st id="ST" editor="cst" />
        </sts>
        <cmds>
            <sends />
            <accepts>
                <cmd id="DISCOVER" />
            </accepts>
        </cmds>
    </nodeDef>
    <!-- Sonos Speakers -->
    <nodeDef id="sonosspeaker" nls="sspk">
        <editors />
        <sts>
            <st id="ST" editor="sstat" />
            <st id="SVOL" editor="svolume" />
            <st id="GV1" editor="sinc" />
            <st id="GV2" editor="sinc" />
            <st id="GV3" editor="bool" />
            <st id="GV4" editor="bool" />
            <st id="GV5" editor="repeat" />
            <st id="GV6" editor="bool" />
            <st id="GV7" editor="source" />
            <st id="GV8" editor="sinc" />
            <st id="GV9" editor="bool" />
        </sts>
        <cmds>
            <sends />
            <accepts>
                <cmd id="VOLUME">
                    <p id="" editor="svolume" init="SVOL" />
                </cmd	>
                <cmd id="BASS">
                    <p id="" editor="sinc" init="GV1" />
                </cmd	>
                <cmd id="TREBLE">
                    <p id="" editor="sinc" init="GV2" />
                </cmd>
                <cmd id="PLAY" />
                <cmd id="PAUSE" />
                <cmd id="STOP" />
                <cmd id="PREVIOUS" />
                <cmd id="NEXT" />
                <cmd id="MUTE" />
                <cmd id="UNMUTE" />
                <cmd id="PARTYMODE" />
                <cmd id="SHUFFLE" />
                <cmd id="CROSS_FADE" />
                <cmd id="JOIN" />
                <cmd id="UNJOIN" />
                <cmd id="REPEAT">
                    <p id="" editor="repeat" init="GV5" />
                  </cmd>
                <cmd id="SOURCE">
                    <p id="" editor="source" init="GV7" />
                  </cmd>
                <cmd id="PLAY_URI">
                  <p id="" editor="uri" />
                </cmd>
            </accepts>
        </cmds>
    </nodeDef>
</nodeDefs>
