<?xml version="1.0" encoding="UTF-8"?>
<nodeDefs>
  <nodeDef id="sonosCtl" nls="sonosCtl">
    <editors />
    <sts>
      <st id="ST" editor="bool" />
    </sts>
    <cmds>
      <sends />
      <accepts>
        <cmd id="DISCOVER" />
      </accepts>
    </cmds>
  </nodeDef>
  <nodeDef id="sonosPlayer" nls="sonosPlayer">
    <editors />
    <sts>
      <st id="ST" editor="transport" />
      <st id="GV0" editor="percent" />
      <st id="GV1" editor="bool" />
      <st id="GV2" editor="bool" />
      <st id="GV3" editor="repeat" />
      <st id="GV4" editor="bool" />
      <st id="GV5" editor="source" />
      <st id="GV6" editor="index" />
      <st id="GV7" editor="bool" />
    </sts>
    <cmds>
      <sends />
      <accepts>
        <cmd id="PLAY" />
        <cmd id="PAUSE" />
        <cmd id="STOP" />
        <cmd id="NEXT" />
        <cmd id="PREV" />
        <cmd id="SET_VOL"><p id="GV0" editor="percent" /></cmd>
        <cmd id="VOL_UP" />
        <cmd id="VOL_DN" />
        <cmd id="SET_MUTE"><p id="GV1" editor="bool" /></cmd>
        <cmd id="TOGGLE_MUTE" />
        <cmd id="SET_SHUFFLE"><p id="GV2" editor="bool" /></cmd>
        <cmd id="SET_REPEAT"><p id="GV3" editor="repeat" /></cmd>
        <cmd id="SET_XFADE"><p id="GV4" editor="bool" /></cmd>
        <cmd id="JOIN"><p id="ADDR" editor="bob" /></cmd>
        <cmd id="UNJOIN" />
        <cmd id="PLAY_URI"><p id="URI" editor="bob" /></cmd>
      </accepts>
    </cmds>
  </nodeDef>
</nodeDefs>
